FROM eclipse-temurin:25-jre

ENV LANGUAGE='en_US:en' \
    QUARKUS_HTTP_HOST=0.0.0.0 \
    QUARKUS_HTTP_PORT=8080 \
    QUARKUS_DATASOURCE_JDBC_URL=jdbc:sqlite:/data/shoe-tracker.db?journal_mode=WAL&busy_timeout=5000 \
    JAVA_TOOL_OPTIONS="-Djava.util.logging.manager=org.jboss.logmanager.LogManager"

RUN mkdir -p /deployments /data \
    && chown -R 185:185 /deployments /data \
    && chmod -R 775 /deployments /data

WORKDIR /deployments

COPY --chown=185:185 build/quarkus-app/lib/ /deployments/lib/
COPY --chown=185:185 build/quarkus-app/*.jar /deployments/
COPY --chown=185:185 build/quarkus-app/app/ /deployments/app/
COPY --chown=185:185 build/quarkus-app/quarkus/ /deployments/quarkus/

VOLUME /data
EXPOSE 8080
USER 185

ENTRYPOINT ["java", "-jar", "/deployments/quarkus-run.jar"]
